# ============================================================
# Libreta Digital — Variables de entorno
# Copiar a .env.local para desarrollo local
# Configurar en Vercel > Settings > Environment Variables para producción
# ============================================================

# --- Supabase ---
# Obtener desde: https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — NUNCA exponer en el cliente, solo en servidor
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Google OAuth ---
# Crear credenciales en: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<tu-dominio>/auth/callback
GOOGLE_CLIENT_ID=<project-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- Resend (email transaccional) ---
# Obtener en: https://resend.com/api-keys
# Dominio verificado necesario para producción
RESEND_API_KEY=re_...
EMAIL_FROM=Libreta Digital <notificaciones@tudominio.com>

# --- App ---
NEXT_PUBLIC_APP_URL=https://tudominio.com
